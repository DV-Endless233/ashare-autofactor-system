{
  "policy_version": "factor.failure_policy.v2",
  "scope": "shared_across_all_phases",
  "$defs": {"failureClass": {"enum": ["semantic_duplicate","semantic_invalid","accounting_mapping_error","data_coverage_fail","data_dependency_blocked","implementation_error","backtest_execution_failed","backtest_metric_fail","economic_meaning_changed","overfit_suspected","direction_dead_end","evaluator_insufficient","infrastructure_api","kanban_or_db_error","cancelled_by_user"]}},
  "failure_classes": {
    "semantic_duplicate": {"meaning":"候选与已有因子在公式、单调等价、参数家族或经济含义上重复","stop_scope":"direction/round","stop_decision":{"stop_direction":true,"stop_round":true},"continuation":{"eligible":true,"scope":"new_semantic_direction","requires_new_semantic_review":true},"next_action":"CLOSE_DUPLICATE_DIRECTION_AND_SELECT_NEW_SEMANTIC_DIRECTION","write_registry":true},
    "semantic_invalid": {"meaning":"无法用单一经济学含义概括，或属于无经济依据的多因子组合","stop_scope":"semantic_attempt","stop_decision":{"stop_attempt":true,"stop_phase":true},"continuation":{"eligible":true,"scope":"same_round_new_mechanism","requires_new_semantic_review":true},"next_action":"RESTART_SEMANTIC_DIRECTION","write_registry":true},
    "accounting_mapping_error": {"meaning":"变量、财务字段、期间或会计口径映射错误","stop_scope":"current_attempt","stop_decision":{"stop_attempt":true},"continuation":{"eligible":true,"scope":"same_round_alternate_field","requires_new_semantic_review":"conditional"},"next_action":"RETRY_OPERATOR_WITH_ALTERNATE_FIELD","write_registry":true},
    "data_coverage_fail": {"meaning":"字段存在但覆盖率、合并后样本或有效观测不足","stop_scope":"current_attempt","stop_decision":{"stop_attempt":true},"continuation":{"eligible":"alternate_field_verified","scope":"same_round_alternate_field","requires_new_semantic_review":false},"next_action":"RETRY_OPERATOR_WITH_ALTERNATE_FIELD","write_registry":"conditional"},
    "data_dependency_blocked": {"meaning":"必需数据库、缓存、ETL 或数据服务不可用","stop_scope":"phase","stop_decision":{"stop_execution":true,"stop_phase":true},"continuation":{"eligible":"data_ready","scope":"resume_same_phase","requires_new_semantic_review":false},"next_action":"RESUME_AFTER_DATA_READY","write_registry":false},
    "implementation_error": {"meaning":"代码、公式、三层结构、因子值生成或回测接线错误","stop_scope":"operator_phase","stop_decision":{"stop_phase":true},"continuation":{"eligible":"within_retry_budget","scope":"same_phase","requires_new_semantic_review":false},"next_action":"RETRY_OPERATOR_IMPLEMENTATION","write_registry":true},
    "backtest_execution_failed": {"meaning":"回测进程、运行命令或中途执行失败，但实现产物仍可复用","stop_scope":"backtest_attempt","stop_decision":{"stop_attempt":true},"continuation":{"eligible":"implementation_artifacts_valid_and_cleanup_complete","scope":"same_phase_retry_backtest","requires_new_semantic_review":false},"next_action":"RETRY_BACKTEST","write_registry":false},
    "backtest_metric_fail": {"meaning":"回测真实完成，但指标未达参考线","stop_scope":"backtest_attempt","stop_decision":{"stop_attempt":true},"continuation":{"eligible":"parameter_budget_remaining_and_not_plateau","scope":"same_round_parameter_retry","requires_new_semantic_review":false},"next_action":"RETRY_OPERATOR_WITH_PARAMETER_SET","write_registry":false},

    "economic_meaning_changed": {"meaning":"operator 实现过程中改变了已审语义含义","stop_scope":"operator_phase","stop_decision":{"stop_phase":true},"continuation":{"eligible":true,"scope":"semantic_design","requires_new_semantic_review":true},"next_action":"RESTART_SEMANTIC_DIRECTION","write_registry":true},
    "overfit_suspected": {"meaning":"结果只在局部窗口、参数点或样本内成立，泛化性不足","stop_scope":"expression_layer","stop_decision":{"stop_expression":true},"continuation":{"eligible":true,"scope":"expanded_validation_or_new_direction","requires_new_semantic_review":false},"next_action":"EXPAND_OUT_OF_SAMPLE_VALIDATION","write_registry":true},
    "direction_dead_end": {"meaning":"同一经济学方向经过可信字段、表达和有限参数尝试后已无继续价值","stop_scope":"direction","stop_decision":{"stop_direction":true,"stop_round":true},"continuation":{"eligible":true,"scope":"new_semantic_direction","requires_new_semantic_review":true},"next_action":"RESTART_SEMANTIC_DIRECTION","write_registry":true},
    "evaluator_insufficient": {"meaning":"evaluator verdict 缺字段、缺证据、无合法 action 或内部矛盾","stop_scope":"publish","stop_decision":{"stop_publish":true},"continuation":{"eligible":true,"scope":"request_valid_verdict","requires_new_semantic_review":false},"next_action":"REQUEST_VALID_EVALUATOR_VERDICT","write_registry":false},
    "infrastructure_api": {"meaning":"provider、token、quota、worker 进程或 API 故障","stop_scope":"execution","stop_decision":{"stop_execution":true},"continuation":{"eligible":true,"scope":"after_infrastructure_recovery","requires_new_semantic_review":false},"next_action":"RETRY_AFTER_INFRA_RECOVERY","write_registry":false},
    "kanban_or_db_error": {"meaning":"Kanban、状态库、事件存储或幂等状态读写失败","stop_scope":"state_progression","stop_decision":{"stop_progression":true},"continuation":{"eligible":true,"scope":"reconcile_after_recovery","requires_new_semantic_review":false},"next_action":"RECONCILE_AND_RETRY","write_registry":false},
    "cancelled_by_user": {"meaning":"用户主动取消当前 round 或执行","stop_scope":"round","stop_decision":{"stop_round":true,"stop_execution":true},"continuation":{"eligible":false,"scope":"user_restart","requires_new_semantic_review":true},"next_action":"WAIT_FOR_USER_RESTART","write_registry":false}
  }
}