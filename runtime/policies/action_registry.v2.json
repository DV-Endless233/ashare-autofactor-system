{
  "policy_version": "factor.action_registry.v2",
  "scope": "shared_across_all_phases",
  "$defs": {"actionCode": {"enum": ["START_OPERATOR_BUILD","RETRY_OPERATOR_WITH_PARAMETER_SET","RETRY_BACKTEST","RETRY_OPERATOR_WITH_ALTERNATE_FIELD","RETRY_OPERATOR_IMPLEMENTATION","REQUEST_PIPELINE_REVIEW","REQUEST_FAILURE_REVIEW","RESTART_SEMANTIC_DIRECTION","CLOSE_DUPLICATE_DIRECTION_AND_SELECT_NEW_SEMANTIC_DIRECTION","EXPAND_OUT_OF_SAMPLE_VALIDATION","REQUEST_VALID_EVALUATOR_VERDICT","RESUME_AFTER_DATA_READY","RETRY_AFTER_INFRA_RECOVERY","RECONCILE_AND_RETRY","WAIT_FOR_USER_RESTART","PROMOTE_TO_HUMAN_REVIEW","PROMOTE_TO_FACTOR_LIBRARY","REQUEST_SEMANTIC_REVIEW","CHECKPOINT_AND_FIX_VALIDATION"]}},
  "actions": [
    {"action_code":"START_OPERATOR_BUILD","allowed_from":["semantic_pre_review:pass"],"target_profile":"dvcoder","target_phase":"operator_build","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["semantic_handoff_published","artifacts_valid"]},
    {"action_code":"RETRY_OPERATOR_WITH_PARAMETER_SET","allowed_from":["operator_build:backtest_metric_fail"],"target_profile":"dvcoder","target_phase":"operator_build","creates_task":true,"requires_semantic_review":false,"max_attempts":"policy_budget","preconditions":["not_plateau","same_meaning","parameter_budget_remaining"]},
    {"action_code":"RETRY_BACKTEST","allowed_from":["operator_build:backtest_execution_failed"],"target_profile":"dvcoder","target_phase":"operator_build","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["implementation_artifacts_valid","backtest_process_cleaned"]},
    {"action_code":"RETRY_OPERATOR_WITH_ALTERNATE_FIELD","allowed_from":["accounting_mapping_error","data_coverage_fail"],"target_profile":"dvcoder","target_phase":"operator_build","creates_task":true,"requires_semantic_review":"conditional","max_attempts":1,"preconditions":["alternate_field_verified","same_meaning"]},
    {"action_code":"RETRY_OPERATOR_IMPLEMENTATION","allowed_from":["implementation_error"],"target_profile":"dvcoder","target_phase":"operator_build","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["implementation_fix_defined","retry_budget_remaining"]},
    {"action_code":"REQUEST_SEMANTIC_REVIEW","allowed_from":["semantic_design:semantic_package_ready"],"target_profile":"evaluator","target_phase":"semantic_pre_review","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["semantic_handoff_published","semantic_artifacts_valid"]},
    {"action_code":"CHECKPOINT_AND_FIX_VALIDATION","allowed_from":["validation_error","incomplete_artifact","incomplete_verdict"],"target_profile":"default","target_phase":"same_phase","creates_task":false,"requires_semantic_review":false,"max_attempts":0,"preconditions":["checkpoint_saved"]},
    {"action_code":"REQUEST_PIPELINE_REVIEW","allowed_from":["operator_build:metrics_pass","operator_build:metric_fail_parameter_attempt_pass"],"target_profile":"evaluator","target_phase":"pipeline_review","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["code_values_metrics_valid","operator_handoff_published"]},
    {"action_code":"REQUEST_FAILURE_REVIEW","allowed_from":["operator_build:metric_fail_parameter_attempt_fail","operator_build:operator_failure"],"target_profile":"evaluator","target_phase":"failure_review","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["failure_analysis_valid"]},
    {"action_code":"RESTART_SEMANTIC_DIRECTION","allowed_from":["semantic_invalid","direction_dead_end","operator_build:economic_meaning_changed","operator_build:metric_fail_parameter_attempt_fail","pipeline_review:direction_dead_end"],"target_profile":"dvcoder","target_phase":"semantic_design","creates_task":true,"requires_semantic_review":true,"max_attempts":"policy_budget","preconditions":["new_economic_direction"]},
    {"action_code":"CLOSE_DUPLICATE_DIRECTION_AND_SELECT_NEW_SEMANTIC_DIRECTION","allowed_from":["semantic_duplicate","pipeline_review:semantic_duplicate"],"target_profile":"default","target_phase":"semantic_design","creates_task":true,"requires_semantic_review":true,"max_attempts":1,"preconditions":["dedup_evidence_published","new_direction_validated"]},
    {"action_code":"EXPAND_OUT_OF_SAMPLE_VALIDATION","allowed_from":["overfit_suspected"],"target_profile":"dvcoder","target_phase":"operator_build","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["new_validation_window_defined","same_meaning"]},
    {"action_code":"REQUEST_VALID_EVALUATOR_VERDICT","allowed_from":["evaluator_insufficient"],"target_profile":"evaluator","target_phase":"pipeline_review","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["original_review_input_preserved"]},
    {"action_code":"RESUME_AFTER_DATA_READY","allowed_from":["data_dependency_blocked"],"target_profile":"dvcoder","target_phase":"operator_build","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["data_preflight_passed","old_lease_released"]},
    {"action_code":"RETRY_AFTER_INFRA_RECOVERY","allowed_from":["infrastructure_api","kanban_or_db_error"],"target_profile":"default","target_phase":"same_phase","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["cleanup_complete","provider_or_store_healthy"]},
    {"action_code":"RECONCILE_AND_RETRY","allowed_from":["kanban_or_db_error"],"target_profile":"default","target_phase":"same_phase","creates_task":true,"requires_semantic_review":false,"max_attempts":1,"preconditions":["state_store_recovered","idempotency_checked"]},
    {"action_code":"WAIT_FOR_USER_RESTART","allowed_from":["cancelled_by_user"],"target_profile":"default","target_phase":"human_review","creates_task":false,"requires_semantic_review":false,"max_attempts":0,"preconditions":["round_cancelled","cleanup_complete"]},
    {"action_code":"PROMOTE_TO_HUMAN_REVIEW","allowed_from":["pipeline_review:pass"],"target_profile":"default","target_phase":"human_review","creates_task":false,"requires_semantic_review":false,"max_attempts":0,"preconditions":["all_required_evidence_valid","candidate_published"]},
    {"action_code":"PROMOTE_TO_FACTOR_LIBRARY","allowed_from":["human_review:approved"],"target_profile":"default","target_phase":"human_review","creates_task":false,"requires_semantic_review":false,"max_attempts":0,"preconditions":["human_review_result_valid","candidate_artifacts_published"]}
  ]
}