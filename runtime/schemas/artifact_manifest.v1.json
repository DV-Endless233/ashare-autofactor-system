{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factor.artifact_manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "artifact_schema", "path", "sha256", "bytes", "producer_profile", "producer_run_id", "input_refs", "status"],
  "properties": {
    "artifact_id": {"type": "string"}, "artifact_schema": {"type": "string"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"}, "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "bytes": {"type": "integer", "minimum": 0}, "producer_profile": {"enum": ["default", "dvcoder", "evaluator"]}, "producer_run_id": {"type": "string"}, "input_refs": {"type": "array", "items": {"type": "string"}}, "data_version": {"type": "string"}, "status": {"enum": ["partial", "staged", "published", "orphaned", "superseded"]}
  },
  "$defs": {"artifactRef": {"type": "object", "required": ["artifact_id", "kind", "path", "required", "sha256", "bytes", "producer"], "properties": {"artifact_id": {"type": "string"}, "kind": {"type": "string"}, "path": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+"}, "required": {"type": "boolean"}, "sha256": {"type": "string"}, "bytes": {"type": "integer", "minimum": 0}, "producer": {"type": "string"}}, "additionalProperties": true}}
}